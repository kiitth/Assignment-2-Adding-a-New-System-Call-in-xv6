diff --git a/getprocs.c b/getprocs.c
new file mode 100644
index 0000000..2132aa1
--- /dev/null
+++ b/getprocs.c
@@ -0,0 +1,11 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+int
+main(void)
+{
+  printf(1, "Processing running: %d/n", getprocs());
+  exit();
+}
+
diff --git a/proc.c b/proc.c
index 806b1b1..3893419 100644
--- a/proc.c
+++ b/proc.c
@@ -532,3 +532,24 @@ procdump(void)
     cprintf("\n");
   }
 }
+
+int
+getprocs(void)
+{
+  int count = 0;
+  struct proc *p;
+
+  acquire(&ptable.lock);
+
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state == RUNNABLE || p->state == RUNNABLE){
+      count++;
+    }
+  }
+
+  release(&ptable.lock);
+
+  return count;
+
+}
+
